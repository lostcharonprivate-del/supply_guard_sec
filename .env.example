# Copy to .env and adjust. Every value here has a working default for local
# development; the ones that matter in a real deployment are marked.

# --- required in production -------------------------------------------------
# Sign JWTs. The app logs a loud warning at startup if this is still the
# default while ENVIRONMENT=production.
JWT_SECRET=change-me-to-a-long-random-string
ENVIRONMENT=development

# --- storage ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://supplyguard:supplyguard@localhost:5432/supplyguard
# Leave empty to run scans in-process and cache in memory (no Redis needed).
REDIS_URL=redis://localhost:6379/0

# --- external APIs ----------------------------------------------------------
# Unauthenticated GitHub access is limited to 60 requests/hour, which one
# repository scan can exhaust. A token raises it to 5,000/hour and is required
# for private repositories and for the Advisory GraphQL API.
GITHUB_TOKEN=

# Optional: enables "Sign in with GitHub" and lets CI monitoring read a user's
# private repositories on their behalf.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- tuning -----------------------------------------------------------------
# Package metadata changes slowly; advisories should not go stale for long.
CACHE_TTL_PACKAGE_METADATA=86400
CACHE_TTL_VULNERABILITIES=21600
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_CONCURRENCY=16
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
